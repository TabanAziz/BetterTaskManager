#pragma code_page(65001)
#define RT_MANIFEST 24

1 ICON "../assets/btm.ico"
1 RT_MANIFEST "btm.manifest"

1 VERSIONINFO
 PRODUCTVERSION 1,1,2,0
 FILEVERSION 1,1,2,0
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "ProductName", "Better Task Manager"
      VALUE "FileDescription", "Better Task Manager"
      VALUE "InternalName", "BTM"
      VALUE "OriginalFilename", "BTM.exe"
      VALUE "ProductVersion", "1.1.2"
      VALUE "FileVersion", "1.1.2"
      VALUE "CompanyName", "TabanAziz"
      VALUE "LegalCopyright", "MIT License, see THIRD-PARTY-LICENSES for other notices"
    END
  END
END
